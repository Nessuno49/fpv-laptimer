#!/bin/bash
# Lap timer: set a new password for the hotspot "Laptimer".
# The new password comes on stdin (so it never shows up in the process list).
# Called by the lap timer (settings) via sudo – allowed in /etc/sudoers.d/laptimer.
# Installed as /usr/local/bin/laptimer-hotspot-password.

HOTSPOT="Laptimer-Hotspot"   # name of the connection in NetworkManager

IFS= read -r PASSWORD
# WPA2: 8 to 63 printable ASCII characters
if [ ${#PASSWORD} -lt 8 ] || [ ${#PASSWORD} -gt 63 ] || ! [[ "$PASSWORD" =~ ^[[:print:]]+$ ]]; then
    echo "invalid password" >&2
    exit 2
fi
if ! nmcli -t -f NAME connection show | grep -qx "$HOTSPOT"; then
    echo "hotspot not set up" >&2
    exit 3
fi
nmcli connection modify "$HOTSPOT" wifi-sec.psk "$PASSWORD" || exit 1
logger -t laptimer-hotspot "Hotspot password changed"

# Hotspot running right now? Restart it a moment later, so the new password applies
# (the lap timer can still answer the browser first).
if nmcli -t -f NAME connection show --active | grep -qx "$HOTSPOT"; then
    (sleep 2; nmcli connection up "$HOTSPOT") >/dev/null 2>&1 &
fi
exit 0
