# Autostart for the lap timer (systemd user service)
# Location on the Pi: ~/.config/systemd/user/laptimer.service
# %h = the user's home directory

[Unit]
Description=Lap timer (camera lap timing)

[Service]
WorkingDirectory=%h/laptimer
# -u: write output to the log at once instead of buffering it
ExecStart=/usr/bin/python3 -u %h/laptimer/laptimer.py
# restart after a crash (or if the camera isn't ready yet at boot)
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
